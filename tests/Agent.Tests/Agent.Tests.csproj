<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 与被测项目保持一致：P7 的捕获/编码/输入全部是 Windows 专有互操作。 -->
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>DeskLink.Agent.Tests</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Media Foundation 编码器/解码器在部分机器上不可用，这类用例必须 Skip 而不是 Fail。 -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Agent\DeskLink.DesktopAgent\DeskLink.DesktopAgent.csproj" />
  </ItemGroup>

</Project>
