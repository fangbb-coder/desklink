  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Tools\DeskLink.Panel\DeskLink.Panel.csproj" />
    <ProjectReference Include="..\..\src\Protocol\DeskLink.Protocol\DeskLink.Protocol.csproj" />
  </ItemGroup>

</Project>
