# desklink-relayd.service — VPS 端中继服务（QUIC + TCP/TLS）
#
# 由 deploy.sh 用 sed 替换 @...@ 占位符后安装到 /etc/systemd/system/。
# 启动：systemctl enable --now desklink-relayd
# 状态：systemctl status desklink-relayd
# 日志：journalctl -u desklink-relayd -f
#
# 依赖：desklink-registryd.service（registry 必须在 relay 之前启动）
# 端口：@RELAY_PORT@/UDP+TCP（QUIC 与 TCP/TLS 复用同端口）

[Unit]
Description=DeskLink relayd（QUIC + TCP/TLS 双监听中继）
Documentation=https://github.com/desklink
After=network-online.target desklink-registryd.service
Wants=network-online.target
Requires=desklink-registryd.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=desklink
Group=desklink
WorkingDirectory=@DATA_DIR@

# 优雅关闭：SIGTERM 后等待 30s 让 QUIC/TLS 连接 drain
ExecStop=/bin/kill -TERM $MAINPID
TimeoutStopSec=30
KillMode=mixed
FinalKillSignal=SIGKILL

ExecStart=@INSTALL_DIR@/relayd \
    --listen :@RELAY_PORT@ \
    --registry http://127.0.0.1:@REG_PORT@ \
    --token-file @CONF_DIR@/registry.token \
    --cert @CONF_DIR@/certs/relay.crt \
    --key @CONF_DIR@/certs/relay.key \
    --socket @DATA_DIR@/regnotify.sock

# 重启策略
Restart=on-failure
RestartSec=3

# 资源限制（QUIC 单连接内存 + fd 上限）
LimitNOFILE=65536
MemoryMax=512M
TasksMax=4096

# 安全强化（systemd ≥ 240）
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
# 写路径仅数据目录（socket 由 registryd 创建，relayd 只读订阅）
ReadWritePaths=@DATA_DIR@
# UDP 是 QUIC 必需；显式放开 AF_INET/AF_INET6（部分发行版的默认沙箱会限制）
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# 系统调用白名单（拒绝其他）
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# 拒内存页可写+可执行（防 shellcode 注入）
MemoryDenyWriteExecute=yes

# 日志走 journald（持久化到 /var/log/journal）
StandardOutput=journal
StandardError=journal
SyslogIdentifier=desklink-relayd

[Install]
WantedBy=multi-user.target
