<Window x:Class="DeskLink.Panel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DeskLink.Panel"
        Title="DeskLink 控制面板" Height="860" Width="1080"
        MinHeight="660" MinWidth="900"
        Background="#F5F6F8" WindowStartupLocation="CenterScreen">

  <!--
    转换器与调色板一律放在控件自身的 Resources：
    不依赖 Application 级静态资源，窗口在任何宿主里都能独立解析。
  -->
  <Window.Resources>
    <vm:BannerBackgroundConverter x:Key="BannerBg" />
    <vm:BannerForegroundConverter x:Key="BannerFg" />
    <vm:BoolToVisibilityConverter x:Key="BoolVis" />
    <vm:NonEmptyToVisibilityConverter x:Key="NonEmptyVis" />

    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="LineBrush" Color="#E2E5EA" />
    <SolidColorBrush x:Key="MutedBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="FieldBrush" Color="#F9FAFB" />
    <SolidColorBrush x:Key="MonoBrush" Color="#111827" />

    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#111827" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <Style x:Key="Lead" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#374151" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="MonoValue" TargetType="TextBox">
      <Setter Property="FontFamily" Value="Consolas, Courier New, monospace" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="Background" Value="{StaticResource FieldBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="#2563EB" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="18,9" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1D4ED8" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#9CA3AF" /></Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Background" Value="#E5E7EB" />
      <Setter Property="Foreground" Value="#111827" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#D1D5DB" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#F3F4F6" /><Setter Property="Foreground" Value="#9CA3AF" /></Trigger>
      </Style.Triggers>
    </Style>

    <!-- 角色选项卡头：做得比普通 Tab 大一档，让"我是主控端 / 我是被控端"一眼可见 -->
    <Style x:Key="RoleTab" TargetType="TabItem">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="28,10" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
  </Window.Resources>

  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />   <!-- 标题 -->
      <RowDefinition Height="Auto" />   <!-- 状态横幅 -->
      <RowDefinition Height="Auto" />   <!-- 忙碌条 -->
      <RowDefinition Height="*" />      <!-- 角色选项卡：主控端 / 被控端 -->
      <RowDefinition Height="Auto" />   <!-- 本机服务（两角色共用） -->
      <RowDefinition Height="Auto" />   <!-- 日志 -->
    </Grid.RowDefinitions>

    <!-- ── 标题 ───────────────────────────────────────────────────────── -->
    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="DeskLink 控制面板" FontSize="22" FontWeight="Bold" Foreground="#111827" />
      <TextBlock Text="先选自己在这套远控里的角色，再按那一页的步骤走；本机服务和高级设置两个角色共用。"
                 FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
    </StackPanel>

    <!-- ── 状态横幅 ─────────────────────────────────────────────────── -->
    <Border Grid.Row="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,10"
            Background="{Binding BannerLevel, Converter={StaticResource BannerBg}}"
            BorderThickness="1"
            BorderBrush="{Binding BannerLevel, Converter={StaticResource BannerFg}}">
      <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="13"
                 Foreground="{Binding BannerLevel, Converter={StaticResource BannerFg}}" />
    </Border>

    <TextBlock Grid.Row="2" Text="{Binding BusyMessage}" Margin="0,0,0,8"
               FontSize="12" Foreground="{StaticResource MutedBrush}"
               Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}" />

    <!-- ── 角色选项卡 ──────────────────────────────────────────────────
         0 = 我是主控端，1 = 我是被控端（SelectedRoleIndex 的取值约定）。
         控制端专属的能力（配对、打开控制界面）全部收在主控端这一页，
         被控端专属的（放行入站端口）收在被控端这一页，互不串味。
    -->
    <TabControl Grid.Row="3" SelectedIndex="{Binding SelectedRoleIndex, Mode=TwoWay}"
                Background="Transparent" BorderThickness="0" Padding="0">

      <!-- ═══ 我是主控端 ═══════════════════════════════════════════════ -->
      <TabItem Header="我是主控端" Style="{StaticResource RoleTab}">
        <!--
          HorizontalScrollBarVisibility 必须显式设成 Disabled：
          StackPanel 会给子元素无限宽，TextWrapping=Wrap 拿不到约束，
          于是 Lead/Hint 那些长说明会被右边缘直接裁掉（用户只看到半句话）。
          关掉横向滚动等于把内容宽度钉在视口宽，Wrap 才真的生效。
        -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,8,0">
          <StackPanel>

            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="第 1 步：一键准备主控端" Style="{StaticResource SectionTitle}" />
                <TextBlock Style="{StaticResource Lead}"
                           Text="把『开启局域网直连』和『注入桌面代理』都关掉，再启动本机服务；已经填了对方公钥的话会顺手完成配对。主控端只往外拨、不接受别人拨进来，所以不需要放行入站端口，也不需要注入桌面代理。" />
                <Button Content="一键准备主控端" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                        Command="{Binding PrepareControllerCommand}" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="第 2 步：把你的公钥交给被控端" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="本机公钥（Base64）" Style="{StaticResource Label}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox Text="{Binding PublicKey, Mode=OneWay}" Style="{StaticResource MonoValue}" />
                  <Button Grid.Column="1" Content="复制" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                          Click="OnCopyPublicKeyClick" />
                </Grid>
                <TextBlock Style="{StaticResource Hint}"
                           Text="直连没有中间人帮忙交换公钥，两台机器必须互相各配一次：对方拿到这串后，要在他那边的『我是被控端』页粘进『对方的公钥』输入框再点配对。只配一边会被对端在握手前主动断开，报错长得像防火墙问题。" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="第 3 步：把被控端的公钥粘进来配对" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="被控端公钥" Style="{StaticResource Label}" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                           Text="和第 2 步是同一件事的两个方向：第 2 步你给对方，第 3 步对方给你。谁先谁后都行。" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox Text="{Binding PeerPub, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MonoValue}"
                           IsReadOnly="False" />
                  <Button Grid.Column="1" Content="配对" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                          Command="{Binding PairCommand}" />
                </Grid>
                <TextBlock Style="{StaticResource Hint}">
                  <!--
                    不能写成 Text="已配对设备数：{Binding PairingCount}（...）"：
                    WPF 里一个属性值里混了字面量和标记扩展时，**整串按字面量处理**，
                    界面上会原样显示 "{Binding PairingCount}"。必须拆成多个 Run。
                  -->
                  <Run Text="已配对设备数：" />
                  <Run Text="{Binding PairingCount, Mode=OneWay}" />
                  <Run Text="（由服务状态实时读取）" />
                </TextBlock>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="第 4 步：打开控制界面去操控对方" Style="{StaticResource SectionTitle}" />
                <TextBlock Style="{StaticResource Lead}"
                           Text="主控端才需要这一步：启动远程操控客户端，在『设备』页选『局域网直连』，填上面说的那个 IP:端口，再点连接。" />
                <Button Content="打开控制界面" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                        Command="{Binding LaunchClientCommand}" />
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ═══ 我是被控端 ═══════════════════════════════════════════════ -->
      <TabItem Header="我是被控端" Style="{StaticResource RoleTab}">
        <!--
          HorizontalScrollBarVisibility 必须显式设成 Disabled：
          StackPanel 会给子元素无限宽，TextWrapping=Wrap 拿不到约束，
          于是 Lead/Hint 那些长说明会被右边缘直接裁掉（用户只看到半句话）。
          关掉横向滚动等于把内容宽度钉在视口宽，Wrap 才真的生效。
        -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,8,0">
          <StackPanel>

            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="第 1 步：一键准备被控端" Style="{StaticResource SectionTitle}" />
                <TextBlock Style="{StaticResource Lead}"
                           Text="放行入站端口 + 开启局域网直连 + 注入桌面代理 + 启动本机服务，一步做完。注入代理意味着你的屏幕和键鼠会被主控端接管，请只对信任的人用。" />
                <Button Content="一键准备被控端" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                        Command="{Binding PrepareControlledCommand}" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="第 2 步：把这两样发给主控端" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="本机公钥（Base64）" Style="{StaticResource Label}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox Text="{Binding PublicKey, Mode=OneWay}" Style="{StaticResource MonoValue}" />
                  <Button Grid.Column="1" Content="复制" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                          Click="OnCopyPublicKeyClick" />
                </Grid>

                <TextBlock Text="本机地址（主控端填这个）" Style="{StaticResource Label}" Margin="0,12,0,4" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox Text="{Binding LocalEndpoint, Mode=OneWay}" Style="{StaticResource MonoValue}" />
                  <Button Grid.Column="1" Content="复制" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                          Click="OnCopyEndpointClick" />
                </Grid>

                <TextBlock Style="{StaticResource Hint}"
                           Text="两台机器要在同一个局域网/子网。地址取的是本机私有网段 IPv4；多网卡或接了 VPN 时请核对主控端填的地址。" />
                <TextBlock Style="{StaticResource Hint}" Text="{Binding QuicText}" />
              </StackPanel>
            </Border>

            <!--
              被控端也必须配主控端：直连握手是双向 SIGMA，两边都认了对方才连得上。
              这一块以前根本不存在，而主控端页的文案却让用户"到被控端页粘进『对方的公钥』"——
              指着一个不存在的控件。被控端一键准备也不配对，于是流程真的走不通。
              与主控端页绑同一个 PeerPub：那边粘了，这边同步可见，反之亦然。
            -->
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="第 3 步：把主控端的公钥粘进来配对" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="对方的公钥（主控端发给你的）" Style="{StaticResource Label}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox Text="{Binding PeerPub, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MonoValue}"
                           IsReadOnly="False" />
                  <Button Grid.Column="1" Content="配对" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                          Command="{Binding PairCommand}" />
                </Grid>
                <TextBlock Style="{StaticResource Hint}"
                           Text="直连必须两边都配。只配主控端这一边的话，对端会在握手前就主动断开，报错长得像防火墙问题。在本页点过『一键准备被控端』之后，也可以直接把主控端的公钥粘到上面那个框里点配对。" />
                <TextBlock Style="{StaticResource Hint}">
                  <Run Text="已配对设备数：" />
                  <Run Text="{Binding PairingCount, Mode=OneWay}" />
                  <Run Text="（由服务状态实时读取）" />
                </TextBlock>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="第 4 步：确认入站端口已放行" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{Binding FirewallText}" FontSize="13" FontWeight="SemiBold" Foreground="#111827" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="被控端必须放行直连端口（TCP 和 UDP 两条规则，缺一条对应协议就握手失败）。放行需要管理员权限：面板会先弹一次 UAC 提示，确认后以管理员身份重新打开自己，再自动放行。" />
                <WrapPanel Margin="0,10,0,0">
                  <Button Content="放行入站端口" Style="{StaticResource PrimaryButton}" Command="{Binding OpenFirewallCommand}" />
                  <TextBlock Text="当前：管理员" Margin="8,0,12,0" VerticalAlignment="Center" FontSize="12"
                             Foreground="#047857" Visibility="{Binding IsElevated, Converter={StaticResource BoolVis}}" />
                  <TextBlock Text="当前：普通权限（放行时会弹 UAC 提示并重启面板）" VerticalAlignment="Center" FontSize="12"
                             Foreground="#B45309"
                             Visibility="{Binding IsElevated, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                </WrapPanel>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <!-- ── 本机服务：两个角色都要用，所以放在选项卡外面 ──────────────────── -->
    <Border Grid.Row="4" Style="{StaticResource CardStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <TextBlock Text="本机服务（主控端 / 被控端共用）" Style="{StaticResource SectionTitle}" />
          <WrapPanel Margin="0,0,0,10">
            <Button Content="启动服务" Style="{StaticResource PrimaryButton}" Command="{Binding StartServiceCommand}" />
            <Button Content="停止服务" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                    Command="{Binding StopServiceCommand}" />
            <Button Content="刷新公钥" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                    Command="{Binding RefreshIdentityCommand}" />
          </WrapPanel>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="运行状态" Style="{StaticResource Label}" />
              <TextBlock Text="运行中" FontWeight="SemiBold" Foreground="#047857"
                         Visibility="{Binding ServiceRunning, Converter={StaticResource BoolVis}}" />
              <TextBlock Text="未运行" FontWeight="SemiBold" Foreground="#6B7280"
                         Visibility="{Binding ServiceRunning, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="直连会话" Style="{StaticResource Label}" />
              <TextBlock Text="{Binding DirectSessions}" FontWeight="SemiBold" Foreground="#111827" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="中继" Style="{StaticResource Label}" />
              <TextBlock Text="{Binding RelayState}" FontWeight="SemiBold" Foreground="#111827" />
            </StackPanel>
            <StackPanel Grid.Column="3">
              <TextBlock Text="端到端" Style="{StaticResource Label}" />
              <TextBlock Text="{Binding E2EState}" FontWeight="SemiBold" Foreground="#111827" />
            </StackPanel>
          </Grid>
        </StackPanel>

        <StackPanel Grid.Column="2">
          <TextBlock Text="高级设置（一般不用动）" Style="{StaticResource SectionTitle}" />
          <Expander Header="展开">
            <StackPanel Margin="0,10,0,0">
              <TextBlock Text="数据目录（实例名 = 路径末段，改了管道名也会跟着变）" Style="{StaticResource Label}" />
              <TextBox Text="{Binding DataDir}" />

              <TextBlock Text="直连端口" Style="{StaticResource Label}" Margin="0,10,0,4" />
              <TextBox Text="{Binding DirectPort}" />

              <CheckBox Content="开启局域网直连（--enable-direct，仅被控端需要）"
                        IsChecked="{Binding EnableDirect}" Margin="0,12,0,0" />
              <CheckBox Content="注入桌面代理（--inject-agent，仅被控端需要；开启后本机键鼠会被远端接管）"
                        IsChecked="{Binding InjectAgent}" Margin="0,6,0,0" />

              <TextBlock Text="文件共享目录（分号分隔；留空=整盘可读，不建议）" Style="{StaticResource Label}" Margin="0,12,0,4" />
              <TextBox Text="{Binding FileScopeText}" />

              <!-- 缺陷②的修法：多屏用户以前只能去命令行加 monitor 参数，面板没有任何入口。 -->
              <TextBlock Text="捕获哪块屏幕（仅被控端；0=主显示器，多屏时才需要改）" Style="{StaticResource Label}" Margin="0,12,0,4" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="80" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding MonitorIndex}" />
                <TextBlock Grid.Column="1" Text="{Binding MonitorIndexText}" Foreground="Gray" Margin="8,0,0,0" VerticalAlignment="Center" />
              </Grid>
              <TextBlock Margin="0,4,0,0" Foreground="Gray" TextWrapping="Wrap"
                         Text="改完要重启本机服务才生效。索引从 0 开始，可用 DeskLink.DesktopAgent.exe --list-monitors 查本机屏幕索引。" />

              <TextBlock Text="中继地址（走公网中继时才需要）" Style="{StaticResource Label}" Margin="0,10,0,4" />
              <TextBox Text="{Binding RelayUrl}" />

              <Button Content="保存设置" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                      Margin="0,12,0,0" Command="{Binding SaveSettingsCommand}" />
            </StackPanel>
          </Expander>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ── 日志 ─────────────────────────────────────────────────────── -->
    <Expander Grid.Row="5" Header="服务日志" IsExpanded="False" Margin="0,0,0,0">
      <TextBox x:Name="LogBox" Height="150" Margin="0,8,0,0" IsReadOnly="True"
               FontFamily="Consolas, Courier New, monospace" FontSize="11"
               Background="#0F172A" Foreground="#E2E8F0" BorderThickness="0"
               Padding="10" VerticalScrollBarVisibility="Auto" />
    </Expander>
  </Grid>
</Window>
