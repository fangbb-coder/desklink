<Window x:Class="DeskLink.Panel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DeskLink.Panel"
        Title="DeskLink 控制面板" Height="820" Width="1080"
        MinHeight="640" MinWidth="900"
        Background="#F5F6F8" WindowStartupLocation="CenterScreen">

  <!--
    转换器与调色板一律放在控件自身的 Resources：
    不依赖 Application 级静态资源，窗口在任何宿主里都能独立解析。
  -->
  <Window.Resources>
    <vm:BannerBackgroundConverter x:Key="BannerBg" />
    <vm:BannerForegroundConverter x:Key="BannerFg" />
    <vm:BoolToVisibilityConverter x:Key="BoolVis" />
    <vm:NonEmptyToVisibilityConverter x:Key="NonEmptyVis" />

    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="LineBrush" Color="#E2E5EA" />
    <SolidColorBrush x:Key="MutedBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="FieldBrush" Color="#F9FAFB" />
    <SolidColorBrush x:Key="MonoBrush" Color="#111827" />

    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#111827" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <Style x:Key="MonoValue" TargetType="TextBox">
      <Setter Property="FontFamily" Value="Consolas, Courier New, monospace" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="Background" Value="{StaticResource FieldBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="#2563EB" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="18,9" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1D4ED8" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#9CA3AF" /></Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Background" Value="#E5E7EB" />
      <Setter Property="Foreground" Value="#111827" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#D1D5DB" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#F3F4F6" /><Setter Property="Foreground" Value="#9CA3AF" /></Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />   <!-- 标题 + 角色 -->
      <RowDefinition Height="Auto" />   <!-- 状态横幅 -->
      <RowDefinition Height="Auto" />   <!-- 忙碌条 -->
      <RowDefinition Height="*" />      <!-- 主体 -->
      <RowDefinition Height="Auto" />   <!-- 日志 -->
    </Grid.RowDefinitions>

    <!-- ── 标题 + 角色切换 ─────────────────────────────────────────── -->
    <Grid Grid.Row="0" Margin="0,0,0,14">
      <StackPanel>
        <TextBlock Text="DeskLink 控制面板" FontSize="22" FontWeight="Bold" Foreground="#111827" />
        <TextBlock Text="这台机器要先成为「可被连接」或「能主动连接」，点下面的角色一键准备即可。"
                   FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button Content="我是被控端" Style="{StaticResource PrimaryButton}"
                Visibility="{Binding IsController, Converter={StaticResource BoolVis}, ConverterParameter=invert}"
                Click="OnPrepareControlledClick" />
        <Button Content="我是控制端" Style="{StaticResource GhostButton}"
                Visibility="{Binding IsController, Converter={StaticResource BoolVis}}"
                Click="OnPrepareControllerClick" />
      </StackPanel>
    </Grid>

    <!-- ── 状态横幅 ─────────────────────────────────────────────────── -->
    <Border Grid.Row="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,10"
            Background="{Binding BannerLevel, Converter={StaticResource BannerBg}}"
            BorderThickness="1"
            BorderBrush="{Binding BannerLevel, Converter={StaticResource BannerFg}}">
      <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="13"
                 Foreground="{Binding BannerLevel, Converter={StaticResource BannerFg}}" />
    </Border>

    <TextBlock Grid.Row="2" Text="{Binding BusyMessage}" Margin="0,0,0,8"
               FontSize="12" Foreground="{StaticResource MutedBrush}"
               Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}" />

    <!-- ── 主体：左 = 身份与配对，右 = 服务与防火墙 ──────────────────── -->
    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左列 -->
        <StackPanel Grid.Column="0">

          <Border Style="{StaticResource CardStyle}">
            <StackPanel>
              <TextBlock Text="① 把这两样发给对方" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="本机公钥（Base64）" Style="{StaticResource Label}" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding PublicKey, Mode=OneWay}" Style="{StaticResource MonoValue}" />
                <Button Grid.Column="1" Content="复制" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                        Click="OnCopyPublicKeyClick" />
              </Grid>

              <TextBlock Text="本机地址（控制端填这个）" Style="{StaticResource Label}" Margin="0,12,0,4" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding LocalEndpoint, Mode=OneWay}" Style="{StaticResource MonoValue}" />
                <Button Grid.Column="1" Content="复制" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                        Click="OnCopyEndpointClick" />
              </Grid>

              <TextBlock Style="{StaticResource Hint}"
                         Text="两台机器要在同一个局域网/子网。地址取的是本机私有网段 IPv4；多网卡或接了 VPN 时请核对控制端填的地址。" />
              <TextBlock Style="{StaticResource Hint}"
                         Text="QUIC 可用：仅说明本机支持，实际能否走 QUIC 取决于两端系统与防火墙 UDP 规则。" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardStyle}">
            <StackPanel>
              <TextBlock Text="② 配对（两边都要做）" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="粘贴对方的公钥" Style="{StaticResource Label}" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding PeerPub, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MonoValue}"
                         IsReadOnly="False" />
                <Button Grid.Column="1" Content="配对" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                        Command="{Binding PairCommand}" />
              </Grid>
              <TextBlock Style="{StaticResource Hint}"
                         Text="直连没有中间人帮忙交换公钥，必须两台机器互相各配一次。只配一边的话，控制端会在 SIGMA 握手前被对端主动断开，报错长得像防火墙问题。" />
              <TextBlock Style="{StaticResource Hint}"
                         Text="已配对设备数：{Binding PairingCount}（由服务状态实时读取）" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardStyle}">
            <StackPanel>
              <TextBlock Text="高级设置" Style="{StaticResource SectionTitle}" />
              <Expander Header="展开（一般不用动）">
                <StackPanel Margin="0,10,0,0">
                  <TextBlock Text="数据目录（实例名 = 路径末段，改了管道名也会跟着变）" Style="{StaticResource Label}" />
                  <TextBox Text="{Binding DataDir}" />

                  <TextBlock Text="直连端口" Style="{StaticResource Label}" Margin="0,10,0,4" />
                  <TextBox Text="{Binding DirectPort}" />

                  <CheckBox Content="开启局域网直连（--enable-direct，仅被控端需要）"
                            IsChecked="{Binding EnableDirect}" Margin="0,12,0,0" />
                  <CheckBox Content="注入桌面代理（--inject-agent，仅被控端需要；开启后本机键鼠会被远端接管）"
                            IsChecked="{Binding InjectAgent}" Margin="0,6,0,0" />

                  <TextBlock Text="文件共享目录（分号分隔；留空=整盘可读，不建议）" Style="{StaticResource Label}" Margin="0,12,0,4" />
                  <TextBox Text="{Binding FileScopeText}" />

                  <TextBlock Text="中继地址（走公网中继时才需要）" Style="{StaticResource Label}" Margin="0,10,0,4" />
                  <TextBox Text="{Binding RelayUrl}" />

                  <Button Content="保存设置" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                          Margin="0,12,0,0" Command="{Binding SaveSettingsCommand}" />
                </StackPanel>
              </Expander>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- 右列 -->
        <StackPanel Grid.Column="2">

          <Border Style="{StaticResource CardStyle}">
            <StackPanel>
              <TextBlock Text="本机服务" Style="{StaticResource SectionTitle}" />
              <WrapPanel Margin="0,0,0,10">
                <Button Content="启动服务" Style="{StaticResource PrimaryButton}" Command="{Binding StartServiceCommand}" />
                <Button Content="停止服务" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                        Command="{Binding StopServiceCommand}" />
                <Button Content="刷新公钥" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                        Command="{Binding RefreshIdentityCommand}" />
              </WrapPanel>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="运行状态" Style="{StaticResource Label}" />
                  <TextBlock Text="运行中" FontWeight="SemiBold" Foreground="#047857"
                             Visibility="{Binding ServiceRunning, Converter={StaticResource BoolVis}}" />
                  <TextBlock Text="未运行" FontWeight="SemiBold" Foreground="#6B7280"
                             Visibility="{Binding ServiceRunning, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="直连会话" Style="{StaticResource Label}" />
                  <TextBlock Text="{Binding DirectSessions}" FontWeight="SemiBold" Foreground="#111827" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="中继" Style="{StaticResource Label}" />
                  <TextBlock Text="{Binding RelayState}" FontWeight="SemiBold" Foreground="#111827" />
                </StackPanel>
                <StackPanel Grid.Column="3">
                  <TextBlock Text="端到端" Style="{StaticResource Label}" />
                  <TextBlock Text="{Binding E2EState}" FontWeight="SemiBold" Foreground="#111827" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardStyle}">
            <StackPanel>
              <TextBlock Text="入站防火墙" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="{Binding FirewallText}" FontSize="13" FontWeight="SemiBold" Foreground="#111827" />
              <TextBlock Style="{StaticResource Hint}"
                         Text="被控端必须放行直连端口（TCP 和 UDP 两条规则，缺一条对应协议就握手失败）。控制端只拨出，不需要放行。放行操作需要管理员权限，面板会自动弹出提权提示。" />
              <WrapPanel Margin="0,10,0,0">
                <Button Content="放行入站端口" Style="{StaticResource PrimaryButton}" Command="{Binding OpenFirewallCommand}" />
                <TextBlock Text="{Binding IsElevated, Converter={StaticResource BoolVis}}" />
                <TextBlock Text="当前：管理员" Margin="8,0,12,0" VerticalAlignment="Center" FontSize="12"
                           Foreground="#047857" Visibility="{Binding IsElevated, Converter={StaticResource BoolVis}}" />
                <TextBlock Text="当前：普通权限（防火墙按钮会自动提权重启）" VerticalAlignment="Center" FontSize="12"
                           Foreground="#B45309"
                           Visibility="{Binding IsElevated, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
              </WrapPanel>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardStyle}">
            <StackPanel>
              <TextBlock Text="控制端界面" Style="{StaticResource SectionTitle}" />
              <TextBlock Style="{StaticResource Hint}"
                         Text="控制端才需要：启动 WPF 客户端，在「设备」页选『局域网直连』，填被控端上面的地址，再点连接。" />
              <Button Content="打开控制界面" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                      Margin="0,10,0,0" Command="{Binding LaunchClientCommand}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>

    <!-- ── 日志 ─────────────────────────────────────────────────────── -->
    <Expander Grid.Row="4" Header="服务日志" IsExpanded="False" Margin="0,4,0,0">
      <TextBox x:Name="LogBox" Height="150" Margin="0,8,0,0" IsReadOnly="True"
               FontFamily="Consolas, Courier New, monospace" FontSize="11"
               Background="#0F172A" Foreground="#E2E8F0" BorderThickness="0"
               Padding="10" VerticalScrollBarVisibility="Auto" />
    </Expander>
  </Grid>
</Window>
