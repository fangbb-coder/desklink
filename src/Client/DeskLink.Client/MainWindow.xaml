<Window x:Class="DeskLink.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DeskLink.Client.Views"
        Title="DeskLink" Height="720" Width="1080">
    <DockPanel>
        <!-- 被控端低干扰状态条常驻底部。 -->
        <views:StatusBar DockPanel.Dock="Bottom" />

        <TabControl SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="设备">
                <views:DevicesView DataContext="{Binding Devices}" />
            </TabItem>
            <TabItem Header="远程">
                <views:RemoteView DataContext="{Binding Remote}" />
            </TabItem>
            <TabItem Header="文件">
                <views:FilesView DataContext="{Binding Files}" />
            </TabItem>
            <TabItem Header="设置">
                <views:SettingsView DataContext="{Binding Settings}" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
