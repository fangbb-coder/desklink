<UserControl x:Class="DeskLink.Client.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 配对 -->
        <GroupBox Grid.Row="0" Header="配对（两台机器都要各配一次；这里填的是**对方的**公钥）">
            <StackPanel Orientation="Horizontal" Margin="4">
                <TextBlock Text="对方公钥" VerticalAlignment="Center" />
                <TextBox Width="230" Margin="6,0" FontFamily="Consolas" FontSize="11"
                         Text="{Binding PairingCode, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="备注" VerticalAlignment="Center" />
                <TextBox Width="120" Margin="6,0" Text="{Binding PairingLabel, UpdateSourceTrigger=PropertyChanged}" />
                <Button Content="配对" Width="72" Command="{Binding PairCommand}" />
            </StackPanel>
        </GroupBox>

        <!-- 路径选择 -->
        <GroupBox Grid.Row="1" Header="连接路径（不自动切换）">
            <StackPanel Orientation="Horizontal" Margin="4">
                <RadioButton Content="中继" IsChecked="{Binding IsRelayMode}" VerticalAlignment="Center" />
                <RadioButton Content="局域网直连" IsChecked="{Binding IsLanMode}" Margin="16,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="IP:端口" Margin="16,0,6,0" VerticalAlignment="Center" />
                <TextBox Width="180" Text="{Binding LanEndpointText, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsLanMode}" />
                <Button Content="输入地址…" Width="90" Margin="6,0,0,0" Click="OnPickLanEndpoint"
                        IsEnabled="{Binding IsLanMode}" />
                <Button Content="连接" Width="72" Margin="8,0,0,0" Command="{Binding ConnectCommand}" />
                <Button Content="刷新" Width="72" Margin="8,0,0,0" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </GroupBox>

        <!-- 设备列表 -->
        <GroupBox Grid.Row="2" Header="已配对设备">
            <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Label}" FontWeight="Bold" />
                                <TextBlock Text="{Binding Fingerprint}" FontFamily="Consolas" FontSize="11" Foreground="Gray" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Online}" VerticalAlignment="Center" Margin="8,0" />
                            <Button Grid.Column="2" Content="撤销" Width="64"
                                    Command="{Binding DataContext.UnpairCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>

        <!--
          状态条放在设备列表**正下方**并加深边框/加重字体：
          连接失败的所有原因都写在这里（Service 没起、没配对、防火墙、SIGMA 失败…），
          以前它是一行灰色小字贴在页面最底下，用户点完"连接"看不到任何变化，
          只会以为"没反应"。可见性本身就是功能。
        -->
        <Border Grid.Row="3" Margin="4,8" Padding="8,6" CornerRadius="4"
                BorderBrush="#93C5FD" BorderThickness="1" Background="#EFF6FF">
            <TextBlock TextWrapping="Wrap" Text="{Binding StatusMessage}"
                       FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8" />
        </Border>

        <TextBlock Grid.Row="4" Margin="4" TextWrapping="Wrap" Foreground="Gray" FontSize="11"
                   Text="中继连接首次会弹出对端指纹确认（TOFU）；局域网直连复用已配对公钥，不弹指纹。" />
    </Grid>
</UserControl>
