<UserControl x:Class="DeskLink.Client.Views.StatusBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <!-- 被控端低干扰状态条：持续可见但不抢焦点、不弹窗（DESIGN 使用流程第 5 条）。 -->
    <Border Background="#22000000" Padding="8,4">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="LimeGreen"
                         Visibility="{Binding IsControlled, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="Bold"
                           Text="正在被控制"
                           Visibility="{Binding IsControlled, Converter={StaticResource BoolToVisibility}}" />
                <!-- 被控端"随时断开"（DESIGN 使用流程第 5 条）：一键关掉本机全部 E2E 会话。 -->
                <Button Margin="8,0,0,0" Padding="8,1" VerticalAlignment="Center"
                        Content="断开" Cursor="Hand"
                        Command="{Binding EndControlCommand}"
                        Visibility="{Binding IsControlled, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <TextBlock Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                       Foreground="Gray" Text="{Binding StatusBarText}" />
        </Grid>
    </Border>
</UserControl>
