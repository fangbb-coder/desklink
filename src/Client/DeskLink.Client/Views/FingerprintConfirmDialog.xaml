<Window x:Class="DeskLink.Client.Views.FingerprintConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认对端设备指纹" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="16" Width="480">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="首次经中继连接该设备，请通过可信渠道核对下面的公钥指纹。指纹不符可能意味着中间人攻击，请勿确认。" />
        <TextBlock x:Name="DeviceNameText" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBox x:Name="FingerprintText" IsReadOnly="True" FontFamily="Consolas"
                 TextWrapping="Wrap" Margin="0,0,0,12" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Width="80" Margin="0,0,8,0" IsCancel="True" Click="OnCancel" />
            <Button Content="确认并信任" Width="120" IsDefault="True" Click="OnConfirm" />
        </StackPanel>
    </StackPanel>
</Window>
