<UserControl x:Class="DeskLink.Client.Views.RemoteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- 定义在本控件内（而非 App.Resources）：这样脱离 Application 也能加载该视图
             （例如单测里只构造窗口、不起 Application 的场景）。 -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 会话内只显示文件 / 全屏 / 断开三个操作（DESIGN）。 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8">
            <Button Content="文件" Width="72"
                    Command="{Binding DataContext.OpenFilesCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Button Content="全屏" Width="72" Margin="8,0,0,0"
                    Command="{Binding DataContext.ToggleFullscreenCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Button Content="断开" Width="72" Margin="8,0,0,0"
                    Command="{Binding DataContext.DisconnectCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Text="{Binding StateText}" />
            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Foreground="Gray"
                       Text="{Binding SoftwareCodec, StringFormat=软件编码: {0}}" />
        </StackPanel>

        <!-- 远端画面。Source 绑到 ViewModel 喂入的 WriteableBitmap。 -->
        <Border Grid.Row="1" Background="Black" Margin="8">
            <Grid>
                <Image Source="{Binding Frame}" Stretch="Uniform" />
                <!-- ACCESS_LOST 期间覆盖提示，避免用户误判掉线。 -->
                <TextBlock Text="正在恢复画面…" Foreground="White" FontSize="22"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IsRecovering, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding ErrorMessage}" Foreground="OrangeRed" FontSize="16"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="12" />
                <!-- 演示画面必须显式标注，避免用户误以为已连上真实远端。 -->
                <TextBlock Text="演示画面（无真实会话）" Foreground="Gold" FontSize="14"
                           HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                           Visibility="{Binding DemoMode, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
