<UserControl x:Class="DeskLink.Client.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- 与 RemoteView/StatusBar 一致：转换器定义在控件自身，
             这样脱离 Application 实例也能加载（单测只构造窗口的场景）。 -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="中继">
            <StackPanel Margin="4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="中继地址" VerticalAlignment="Center" Width="90" />
                    <TextBox Width="360" Text="{Binding RelayUrl, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="OrangeRed"
                               Text="{Binding RelayUrlValidation.Error}" />
                </StackPanel>
                <TextBlock Margin="90,4,0,0" Foreground="Gray" FontSize="11"
                           Text="scheme 决定传输：quic:// 强制 QUIC；tls:// 强制 TCP/TLS；https:// 优先 QUIC 可回落。首次连接需确认中继证书指纹。" />
                <TextBlock Margin="90,2,0,0" Foreground="Gray" FontSize="11">
                    <Run Text="当前生效：" />
                    <Run>
                        <!--
                          必须显式 Mode=OneWay：Run.Text 的默认绑定模式是 TwoWay，
                          而 ActiveRelayUrl 只有 private setter（它是"服务当前在用"的值，
                          不是用户可编辑的输入），WPF 会在运行时抛 InvalidOperationException
                          导致整个客户端启动即崩。语义上它本来就只该显示。
                        -->
                        <Run.Text>
                            <Binding Path="ActiveRelayUrl" Mode="OneWay" FallbackValue="(未配置)" />
                        </Run.Text>
                    </Run>
                </TextBlock>
                <!-- 诚实性（缺陷③）：保存了但没重启时必须显式告知，不能只弹"已保存" -->
                <TextBlock Margin="90,2,0,0" FontSize="11" Foreground="OrangeRed"
                           FontWeight="Bold" TextWrapping="Wrap"
                           Visibility="{Binding HasPendingRelayChange, Converter={StaticResource BoolToVisibility}}"
                           Text="注意：上面保存的地址尚未生效，服务当前仍在使用“当前生效”的地址。请重启 DeskLinkService。" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="证书指纹" VerticalAlignment="Center" Width="90" />
                    <TextBlock Text="{Binding RelayCertificateFingerprint}" FontFamily="Consolas" VerticalAlignment="Center" />
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center"
                               Text="{Binding RelayCertificateConfirmed, StringFormat=已确认: {0}}" />
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="局域网直连">
            <StackPanel Orientation="Horizontal" Margin="4">
                <CheckBox Content="启用局域网直连" IsChecked="{Binding DirectEnabled}" VerticalAlignment="Center" />
                <TextBlock Text="监听端口" Margin="16,0,6,0" VerticalAlignment="Center" />
                <TextBox Width="90" Text="{Binding DirectPort, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="OrangeRed"
                           Text="{Binding IsDirectPortValid, StringFormat=端口合法: {0}}" />
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="桌面代理（被控端）">
            <StackPanel Orientation="Horizontal" Margin="4">
                <Button Content="启动" Width="72" Command="{Binding StartAgentCommand}" />
                <Button Content="停止" Width="72" Margin="8,0,0,0" Command="{Binding StopAgentCommand}" />
                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center"
                           Text="{Binding AgentRunning, StringFormat=运行中: {0}}" />
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="文件授权目录（scope；为空表示一律拒绝）">
            <ListBox ItemsSource="{Binding FileScopeRoots}" Margin="4" />
        </GroupBox>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="4,8,0,0">
            <Button Content="加载" Width="72" Command="{Binding LoadCommand}" />
            <Button Content="保存" Width="72" Margin="8,0,0,0" Command="{Binding SaveCommand}" />
            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Foreground="DarkSlateBlue"
                       Text="{Binding StatusMessage}" />
        </StackPanel>
    </Grid>
</UserControl>
